if(NOT EXISTS "${REPORT}")
    message(FATAL_ERROR "Lizenzübersicht wurde nicht erzeugt")
endif()
file(READ "${REPORT}" CONTENT)
foreach(CRATE "qrcode" "poppler-rs" "serde_json" "image")
    if(NOT CONTENT MATCHES "${CRATE} [0-9]")
        message(FATAL_ERROR "Abhängigkeit ${CRATE} fehlt in der Lizenzübersicht")
    endif()
endforeach()
if(NOT CONTENT MATCHES "Lizenz:")
    message(FATAL_ERROR "Lizenzangaben fehlen")
endif()
